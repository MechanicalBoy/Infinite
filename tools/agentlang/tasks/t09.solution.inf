infinite-patch 1
node 1 Notes Random Note Generator
  id notes
  i rangeLow 60
end
node 2 Synths Wavetable
  id synth
  f volume 0.5
end
node 3 Utility Audio Out
  id speakers
end
node 4 Source Shape
  id picture
end
node 5 Utility Output
  id out
end
note synth notes notes
aud speakers audio synth
cable out in picture
