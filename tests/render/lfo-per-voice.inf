infinite-patch 1
# Per-voice modulation smoke (v0.6 2.12): an LFO with "per voice" on, cabled into Analog's cutoff.
# Random Note Generator plays overlapping notes; each note's filter sweep starts at its own note-on.
node 1 Notes Random Note Generator
  id notes
end
node 2 Synths Analog
  id synth
end
node 3 Modulators LFO
  id lfo
  b voice 1
  i rateMode 2
  f rateHz 3
end
node 4 Utility Audio Out
  id speakers
end
node 5 Source Shape
  id picture
end
node 6 Utility Output
  id out
end
note synth 0 notes
aud speakers 0 synth
cable out 0 picture
mod synth cutoff lfo 0 0 1 0.5
