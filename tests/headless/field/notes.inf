infinite-patch 1
# E_FIELD_COMPILE: a Field Notes script that calls a function that does not exist.
node 1 Notes Field Notes
  id seq
  s code if (tick(1/4) > 0.5) { note(bogusfn(60), 0.8, 1/4) }
end
node 2 Synths Field Synth
  id syn
end
node 3 Utility Audio Out
  id speaker
end
note syn 0 seq
aud speaker 0 syn
