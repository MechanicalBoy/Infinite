{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Supersaw Lead Synth",
    "author": "Infinite",
    "description": "Multi-oscillator detuned hypersaw lead synthesizer with sub-octave support, resonant filter and snappy ADSR envelope.",
    "domain": "synth"
  },
  "device": {
    "code": "param float cutoff = 2600.0 [120.0, 14000.0];\nparam float res = 0.72 [0.0, 0.96];\nparam float detune = 0.032 [0.002, 0.08];\nparam float envMod = 0.68 [0.0, 1.0];\nparam float decay = 0.45 [0.05, 2.5];\nparam float sub = 0.4 [0.0, 1.0];\nstate float p1 = 0;\nstate float p2 = 0;\nstate float p3 = 0;\nstate float subP = 0;\nstate float env = 0;\nstate float lp1 = 0;\nstate float lp2 = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\ndecayRate = clamp(1.0 / (sr * decay), 0.00004, 0.015);\nenv = if(target > env, env + (target - env) * 0.12, env - env * decayRate);\n\nf0 = clamp(freq, 20.0, 5000.0);\nstep1 = f0 / sr;\nstep2 = (f0 * (1.0 + detune)) / sr;\nstep3 = (f0 * (1.0 - detune)) / sr;\nsubStep = (f0 * 0.5) / sr;\n\np1 = (p1 + step1) % 1.0;\np2 = (p2 + step2) % 1.0;\np3 = (p3 + step3) % 1.0;\nsubP = (subP + subStep) % 1.0;\n\nsaw1 = 2.0 * p1 - 1.0;\nsaw2 = 2.0 * p2 - 1.0;\nsaw3 = 2.0 * p3 - 1.0;\nsawMix = (saw1 + saw2 + saw3) * 0.38;\nsubOsc = sin(6.2831853 * subP) * sub;\nraw = sawMix + subOsc;\n\nfCut = clamp((cutoff + env * envMod * 7000.0) / sr * 2.2, 0.005, 0.46);\nq = 1.0 - res * 0.92;\nhp = raw - lp1 - q * lp2;\nlp2 = lp2 + fCut * hp;\nlp1 = lp1 + fCut * lp2;\n\nsat = lp1 / (1.0 + abs(lp1) * 0.25);\nout = sat * (0.2 + env * 0.8) * 0.45;\n",
    "params": {
      "cutoff": 2600.0,
      "res": 0.72,
      "detune": 0.032,
      "envMod": 0.68,
      "decay": 0.45,
      "sub": 0.4
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
