{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Tape Phaser FX",
    "author": "Infinite",
    "description": "4-stage optical tape phaser with swept allpass notches, feedback resonance and warm diode saturation.",
    "domain": "sample"
  },
  "device": {
    "code": "param float rate = 0.45 [0.05, 6.0];\nparam float depth = 0.75 [0.0, 1.0];\nparam float feedback = 0.62 [0.0, 0.94];\nparam float center = 1400.0 [250.0, 6000.0];\nparam float drive = 1.8 [1.0, 5.0];\nparam float mix = 0.55 [0.0, 1.0];\nstate float lfoP = 0;\nstate float ap1 = 0;\nstate float ap2 = 0;\nstate float ap3 = 0;\nstate float ap4 = 0;\nstate float fb = 0;\n\nlfoP = (lfoP + rate / sr) % 1.0;\nlfo = sin(6.2831853 * lfoP) * depth;\n\nfSweep = clamp(center * (1.0 + lfo * 0.75), 100.0, 9000.0);\nallpassCoeff = clamp(1.0 - (6.2831853 * fSweep / sr), -0.95, 0.95);\n\nu = (in * drive) + (fb * feedback);\nsat = u / (1.0 + abs(u) * 0.22);\n\ny1 = ap1 - allpassCoeff * sat;\nap1 = sat + allpassCoeff * y1;\n\ny2 = ap2 - allpassCoeff * y1;\nap2 = y1 + allpassCoeff * y2;\n\ny3 = ap3 - allpassCoeff * y2;\nap3 = y2 + allpassCoeff * y3;\n\ny4 = ap4 - allpassCoeff * y3;\nap4 = y3 + allpassCoeff * y4;\n\nfb = y4;\nwet = y4;\nout = in * (1.0 - mix) + wet * mix;\n",
    "params": {
      "rate": 0.45,
      "depth": 0.75,
      "feedback": 0.62,
      "center": 1400.0,
      "drive": 1.8,
      "mix": 0.55
    },
    "nodeSettings": {}
  }
}
