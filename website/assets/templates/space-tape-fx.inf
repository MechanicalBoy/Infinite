infinite-patch 1
# Space Tape FX: dual-peak resonant formant filter
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
end
node 2 Synths Analog
  id synth
  pos 480 1024
end
node 3 AudioEffects Field Effect
  id tape
  pos 1020 1024
  s code param float vowel = 0.5 [0.0, 1.0]\nparam float resonance = 0.82 [0.1, 0.98]\nparam float drive = 1.8 [1.0, 5.0]\nparam float lfoSpeed = 1.2 [0.1, 8.0]\nparam float lfoDepth = 0.35 [0.0, 1.0]\nparam float mix = 0.85 [0.0, 1.0]\nstate float lfoP = 0\nstate float bp1 = 0\nstate float lp1 = 0\nstate float bp2 = 0\nstate float lp2 = 0\n\nlfoP = (lfoP + lfoSpeed / sr) % 1.0\nmodVal = sin(6.283185 * lfoP) * lfoDepth\nv = clamp(vowel + modVal, 0.0, 1.0)\n\nf1 = clamp(300.0 + v * 550.0, 150.0, 1500.0)\nf2 = clamp(900.0 + (1.0 - v) * 1600.0, 600.0, 3200.0)\n\nu = in * drive\nsat = u / (1.0 + abs(u) * 0.25)\n\nq = 1.0 - resonance * 0.92\nw1 = clamp(f1 / sr * 2.5, 0.005, 0.42)\nhp1 = sat - lp1 - q * bp1\nbp1 = bp1 + w1 * hp1\nlp1 = lp1 + w1 * bp1\n\nw2 = clamp(f2 / sr * 2.5, 0.005, 0.42)\nhp2 = sat - lp2 - q * bp2\nbp2 = bp2 + w2 * hp2\nlp2 = lp2 + w2 * bp2\n\nwet = (bp1 * 1.3 + bp2 * 1.0)\nout = in * (1.0 - mix) + wet * mix\n
end
node 4 Utility Audio Out
  id speakers
  pos 1560 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 0.655 0.694 1.0
  f size 0.25
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Space Tape & Formant Filter. Dual resonant peaks with vowel LFO morphing.
  f width 340
  f height 120
end
note synth 0 notes
aud tape 0 synth
aud speakers 0 tape
aud ana 0 tape
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
