infinite-patch 1
# Acid Bass Synth: resonant 303-style Field Synth
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.25
  i rangeLow 36
  i rangeHigh 60
end
node 2 Synths Field Synth
  id synth
  pos 480 1024
  s code param float cutoff = 1800.0 [80.0, 9000.0]\nparam float res = 0.78 [0.0, 0.98]\nparam float envMod = 0.65 [0.0, 1.0]\nparam float decay = 0.35 [0.05, 1.5]\nparam float drive = 2.4 [1.0, 6.0]\nparam float sub = 0.45 [0.0, 1.0]\nstate float phase = 0\nstate float subPhase = 0\nstate float env = 0\nstate float s1 = 0\nstate float s2 = 0\nstate float s3 = 0\nstate float s4 = 0\n\ntarget = if(gate > 0.5, 1.0, 0.0)\ndecayRate = clamp(1.0 / (sr * decay), 0.00005, 0.01)\nenv = if(target > env, env + (target - env) * 0.08, env - env * decayRate)\n\npStep = clamp(freq, 20.0, 4000.0) / sr\nphase = (phase + pStep) % 1.0\nsubPhase = (subPhase + pStep * 0.5) % 1.0\n\nsaw = 2.0 * phase - 1.0\nsubOsc = sin(6.2831853 * subPhase) * sub\nraw = saw + subOsc\n\nfCut = clamp((cutoff + env * envMod * 6000.0) / sr * 2.4, 0.004, 0.45)\nfeedback = (s4 * res * 3.8) / (1.0 + abs(s4) * 0.9)\nu = (raw * drive) - feedback\nsat = u / (1.0 + abs(u) * 0.35)\ns1 = s1 + fCut * (sat - s1)\ns2 = s2 + fCut * (s1 - s2)\ns3 = s3 + fCut * (s2 - s3)\ns4 = s4 + fCut * (s3 - s4)\n\nout = s4 * (0.28 + env * 0.72) * 0.4\n
end
node 3 Utility Audio Out
  id speakers
  pos 1020 1024
end
node 4 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 5 Source Shape
  id pic
  pos 0 162
  c fillColor 1 0.42 0.21
  f size 0.25
end
node 6 Utility Output
  id out
  pos 460 0
end
node 7 Compositing Comment
  pos 0 722
  s text Acid Bassline. Polyphonic Field Synth with diode-style ladder saturation.
  f width 340
  f height 120
end
note synth 0 notes
aud speakers 0 synth
aud ana 0 synth
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
