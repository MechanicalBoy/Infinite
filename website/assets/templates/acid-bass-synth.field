{
  "format": "field",
  "version": 1,
  "meta": {
    "name": "Acid Bass Synth",
    "author": "Infinite",
    "description": "Resonant transistor-style acid bass synthesizer with saturated diode ladder filter and sub-octave drive.",
    "domain": "synth"
  },
  "device": {
    "code": "param float cutoff = 1800.0 [80.0, 9000.0];\nparam float res = 0.78 [0.0, 0.98];\nparam float envMod = 0.65 [0.0, 1.0];\nparam float decay = 0.35 [0.05, 1.5];\nparam float drive = 2.4 [1.0, 6.0];\nparam float sub = 0.45 [0.0, 1.0];\nstate float phase = 0;\nstate float subPhase = 0;\nstate float env = 0;\nstate float s1 = 0;\nstate float s2 = 0;\nstate float s3 = 0;\nstate float s4 = 0;\n\ntarget = if(gate > 0.5, 1.0, 0.0);\ndecayRate = clamp(1.0 / (sr * decay), 0.00005, 0.01);\nenv = if(target > env, env + (target - env) * 0.08, env - env * decayRate);\n\npStep = clamp(freq, 20.0, 4000.0) / sr;\nphase = (phase + pStep) % 1.0;\nsubPhase = (subPhase + pStep * 0.5) % 1.0;\n\nsaw = 2.0 * phase - 1.0;\nsubOsc = sin(6.2831853 * subPhase) * sub;\nraw = saw + subOsc;\n\nfCut = clamp((cutoff + env * envMod * 6000.0) / sr * 2.4, 0.004, 0.45);\nfeedback = (s4 * res * 3.8) / (1.0 + abs(s4) * 0.9);\nu = (raw * drive) - feedback;\nsat = u / (1.0 + abs(u) * 0.35);\ns1 = s1 + fCut * (sat - s1);\ns2 = s2 + fCut * (s1 - s2);\ns3 = s3 + fCut * (s2 - s3);\ns4 = s4 + fCut * (s3 - s4);\n\nout = s4 * (0.28 + env * 0.72) * 0.4;\n",
    "params": {
      "cutoff": 1800.0,
      "res": 0.78,
      "envMod": 0.65,
      "decay": 0.35,
      "drive": 2.4,
      "sub": 0.45
    },
    "nodeSettings": {
      "maxVoices": 8
    }
  }
}
