infinite-patch 1
# Tape Phaser FX: 4-stage optical tape phaser with swept allpass notches
node 1 Notes Random Note Generator
  id notes
  pos 0 1024
  f rateBeats 0.5
end
node 2 Synths Analog
  id synth
  pos 480 1024
end
node 3 AudioEffects Field Effect
  id phaser
  pos 1020 1024
  s code param float rate = 0.45 [0.05, 6.0]\nparam float depth = 0.75 [0.0, 1.0]\nparam float feedback = 0.62 [0.0, 0.94]\nparam float center = 1400.0 [250.0, 6000.0]\nparam float drive = 1.8 [1.0, 5.0]\nparam float mix = 0.55 [0.0, 1.0]\nstate float lfoP = 0\nstate float ap1 = 0\nstate float ap2 = 0\nstate float ap3 = 0\nstate float ap4 = 0\nstate float fb = 0\n\nlfoP = (lfoP + rate / sr) % 1.0\nlfo = sin(6.2831853 * lfoP) * depth\n\nfSweep = clamp(center * (1.0 + lfo * 0.75), 100.0, 9000.0)\nallpassCoeff = clamp(1.0 - (6.2831853 * fSweep / sr), -0.95, 0.95)\n\nu = (in * drive) + (fb * feedback)\nsat = u / (1.0 + abs(u) * 0.22)\n\ny1 = ap1 - allpassCoeff * sat\nap1 = sat + allpassCoeff * y1\n\ny2 = ap2 - allpassCoeff * y1\nap2 = y1 + allpassCoeff * y2\n\ny3 = ap3 - allpassCoeff * y2\nap3 = y2 + allpassCoeff * y3\n\ny4 = ap4 - allpassCoeff * y3\nap4 = y3 + allpassCoeff * y4\n\nfb = y4\nwet = y4\nout = in * (1.0 - mix) + wet * mix\n
end
node 4 Utility Audio Out
  id speakers
  pos 1560 1024
end
node 5 Modulators Audio Analyze
  id ana
  pos 0 2200
end
node 6 Source Shape
  id pic
  pos 0 162
  c fillColor 1 0.42 0.21
  f size 0.25
end
node 7 Utility Output
  id out
  pos 460 0
end
node 8 Compositing Comment
  pos 0 722
  s text Tape Phaser. 4-stage optical phaser with swept allpass notches and feedback saturation.
  f width 340
  f height 120
end
note synth 0 notes
aud phaser 0 synth
aud speakers 0 phaser
aud ana 0 phaser
cable out 0 pic
mod pic sizeX ana 0 0 1 0.5 0.15 0.45
mod pic sizeY ana 0 0 1 0.5 0.15 0.45
