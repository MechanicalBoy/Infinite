infinite-patch 1
# Art prompt: "Dusk over a still sea" - ukiyo-e woodblock, flat inks and paper grain.
# Composition: horizon on the lower third, vermilion sun on the golden-ratio line (x = 0.618),
# a broken sun-road down the water, seigaiha wave scales receding in perspective, big quiet sky.
node 1 Source FieldPixel
  id scene
  f width 1920
  f height 1080
  s code h = 0.38; sx = 0.618; sy = h + 0.2 + 0.012 * sin(t * 0.5); p = vec2((uv.x - sx) * aspect, uv.y - sy); sun = smoothstep(0.112, 0.108, length(p)); halo = 0.18 * smoothstep(0.34, 0.0, length(p)); skyt = clamp((uv.y - h) / (1.0 - h), 0.0, 1.0); band = floor(skyt * 7.0) / 7.0; sky = mix(vec3(0.96, 0.78, 0.62), vec3(0.20, 0.27, 0.45), pow(band, 0.8)); sky = sky + vec3(0.9, 0.35, 0.15) * halo; sky = mix(sky, vec3(0.88, 0.22, 0.12), sun); v = max(h - uv.y, 0.0); k = 1.0 / (v + 0.07); q = vec2((uv.x - 0.5) * aspect * k * 0.5 + t * 0.03, k * 0.35 - t * 0.04); a = fract(q) - 0.5; b = fract(q + 0.5) - 0.5; d = min(length(a * vec2(1.0, 1.25)), length(b * vec2(1.0, 1.25))); ring = abs(fract(d * 7.0) - 0.5); ink = smoothstep(0.36, 0.40, ring); shade = clamp(v / h, 0.0, 1.0); deep = mix(vec3(0.07, 0.12, 0.27), vec3(0.04, 0.07, 0.17), shade); lite = mix(vec3(0.30, 0.42, 0.58), vec3(0.17, 0.27, 0.45), shade); sea = mix(deep, lite, ink); road = smoothstep(0.10, 0.02, abs(uv.x - sx) * aspect) * smoothstep(0.0, 0.4, 1.0 - v / h); broken = step(0.45, fract(k * 0.9 - t * 0.05)); sea = mix(sea, vec3(0.93, 0.45, 0.20), road * broken * 0.85); horizon = smoothstep(0.004, 0.0, abs(uv.y - h)); col0 = mix(sea, sky, step(h, uv.y)); col = col0 + vec3(0.9, 0.8, 0.6) * horizon * 0.25;
end
node 2 Effects vignette
  id vig
  f uAmount 0.45
end
node 3 Effects addnoise
  id grain
  f uAmount 0.05
end
node 4 Utility Output
  id out
end
node 5 Notes Random Note Generator
  id notes
end
node 6 Synths Wavetable
  id pad
end
node 7 AudioEffects Reverb
  id hall
end
note pad 0 notes
aud hall 0 pad
aud out 1 hall
cable vig 0 scene
cable grain 0 vig
cable out 0 grain
