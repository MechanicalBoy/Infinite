infinite-patch 1
# Prismatic bloom: lily + atom orbits + spectral dispersion. Generated by art/prism/gen_prism.py
node 1 Source FieldPixel
  id scene
  pos 0 332
  f width 1280
  f height 1280
  s code breath = 0.5 + 0.5 * sin(6.2832 * t / 12.0); flash = 0.0; orbit = fract(t / 16.0); p = vec2((uv.x - 0.5) * aspect, uv.y - 0.5) * 0.95; r = length(p); a = atan2(p.y, p.x) + t * 0.05 + orbit * 6.2832; open = 0.55 + 0.45 * breath; lobe = pow(abs(cos(3.0 * a)), 0.7); petal = (0.16 + 0.20 * open) * (0.40 + 0.60 * lobe) + 0.015 * sin(12.0 * a + t * 0.5); curl = 0.008 * sin(a * 9.0 - t * 0.8 + r * 14.0) * open; d = r - petal - curl; body = smoothstep(0.012, -0.012, d) * smoothstep(0.0, 0.14, r + 0.04); core = exp(-r * 14.0) * (0.25 + 0.45 * open); inner = 0.28 + 0.60 * smoothstep(0.0, petal, r) * (0.6 + 0.4 * lobe); w = clamp(1.0 - abs(d + 0.012) / (0.060 + 0.040 * open), 0.0, 1.0); w = w * w; hue = d * 12.0 + a * 0.30 + t * 0.10; rb = vec3(0.5 + 0.5 * cos(6.2832 * (hue + 0.0)), 0.5 + 0.5 * cos(6.2832 * (hue + 0.333)), 0.5 + 0.5 * cos(6.2832 * (hue + 0.667))); rb = pow(rb, vec3(0.8)) * 1.25; spec = rb * w * (0.85 + 0.5 * flash) * smoothstep(-0.02, 0.01, d + 0.045); halo = rb * exp(-abs(d) * 10.0) * 0.30 * step(0.0, d); white = vec3(0.93, 0.94, 0.9) * body * inner; col = white * 0.8 + spec + halo + vec3(1.0, 0.9, 0.7) * core * 0.6; ph0 = 0.0 * 1.0472 + t * 0.07 * (1.0 + 0.0) - orbit * 3.0; ca0 = cos(ph0); sa0 = sin(ph0); q0 = vec2(p.x * ca0 + p.y * sa0, -p.x * sa0 + p.y * ca0); e0 = length(vec2(q0.x / (0.62 + 0.08 * open), q0.y / (0.20 + 0.04 * breath))); de0 = abs(e0 - 1.0); hue0 = e0 * 2.0 + 0.0 * 0.3 + t * 0.15; rb0 = vec3(0.5 + 0.5 * cos(6.2832 * hue0), 0.5 + 0.5 * cos(6.2832 * (hue0 + 0.333)), 0.5 + 0.5 * cos(6.2832 * (hue0 + 0.667))); col = col + rb0 * exp(-de0 * 40.0) * 0.6 + vec3(1.0, 0.95, 0.85) * exp(-de0 * 220.0) * 0.35; ph1 = 1.0 * 1.0472 + t * 0.07 * (1.0 + 1.0) - orbit * 3.0; ca1 = cos(ph1); sa1 = sin(ph1); q1 = vec2(p.x * ca1 + p.y * sa1, -p.x * sa1 + p.y * ca1); e1 = length(vec2(q1.x / (0.62 + 0.08 * open), q1.y / (0.20 + 0.04 * breath))); de1 = abs(e1 - 1.0); hue1 = e1 * 2.0 + 1.0 * 0.3 + t * 0.15; rb1 = vec3(0.5 + 0.5 * cos(6.2832 * hue1), 0.5 + 0.5 * cos(6.2832 * (hue1 + 0.333)), 0.5 + 0.5 * cos(6.2832 * (hue1 + 0.667))); col = col + rb1 * exp(-de1 * 40.0) * 0.6 + vec3(1.0, 0.95, 0.85) * exp(-de1 * 220.0) * 0.35; ph2 = 2.0 * 1.0472 + t * 0.07 * (1.0 + 2.0) - orbit * 3.0; ca2 = cos(ph2); sa2 = sin(ph2); q2 = vec2(p.x * ca2 + p.y * sa2, -p.x * sa2 + p.y * ca2); e2 = length(vec2(q2.x / (0.62 + 0.08 * open), q2.y / (0.20 + 0.04 * breath))); de2 = abs(e2 - 1.0); hue2 = e2 * 2.0 + 2.0 * 0.3 + t * 0.15; rb2 = vec3(0.5 + 0.5 * cos(6.2832 * hue2), 0.5 + 0.5 * cos(6.2832 * (hue2 + 0.333)), 0.5 + 0.5 * cos(6.2832 * (hue2 + 0.667))); col = col + rb2 * exp(-de2 * 40.0) * 0.6 + vec3(1.0, 0.95, 0.85) * exp(-de2 * 220.0) * 0.35; beam = exp(-abs(p.y) * 160.0) * exp(-abs(p.x) * 1.2) * (0.08 + 0.35 * flash); col = col + vec3(1.0, 0.55, 0.2) * beam; col = col * (1.0 - smoothstep(0.55, 1.1, r) * 0.6);
end
